{
  "name": "cutline-video-editor",
  "version": "0.8.7",
  "description": "A private, watermark-free local video editor for Windows.",
  "author": "Cutline",
  "main": "electron/main.cjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-whisper-runtime.mjs && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/prepare-whisper-runtime.mjs && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:build": "node scripts/prepare-whisper-runtime.mjs && node scripts/build-native.mjs && vite build --config vite.desktop.config.ts",
    "desktop:run": "npm run desktop:build && electron electron/main.cjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable --x64 && node scripts/prune-releases.mjs",
    "test": "npm run test:unit && npm run test:engine && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node scripts/build-native.mjs && node tests/run-unit.mjs && node --test tests/installed-fonts.test.cjs tests/codex-connection.test.cjs tests/custom-api.test.cjs tests/export-files.test.cjs",
    "test:engine": "node tests/run-engine.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/whisper-runtime",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "ai": "^7.0.134",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.30.0",
    "mediabunny": "1.61.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.cutline.editor",
    "productName": "Cutline",
    "copyright": "Copyright (c) 2026 Cutline",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "outputs/desktop"
    },
    "files": [
      "dist-desktop/**/*",
      "dist-native/**/*",
      "electron/**/*",
      "public/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Cutline-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cutline",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Cutline-Portable-${version}-${arch}.${ext}"
    }
  }
}
